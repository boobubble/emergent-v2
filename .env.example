# =============================================================================
# BooBubble / Community Platform — Environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# =============================================================================

# ---- CLIENT-VISIBLE (bundled into the browser) --------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ---- SERVER-ONLY (used by server functions / SSR / edge runtime) --------------
# Same URL / project ref; publishable key is the anon key. NEVER commit real
# values. The service-role key BYPASSES row-level security — treat it like a
# root password. Store it in your host's secret manager, not in git.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- OPTIONAL AI / INTEGRATIONS ----------------------------------------------
# LOVABLE_API_KEY is auto-managed on Lovable Cloud. Only set it when self-hosting
# and using the Lovable AI Gateway for chat/image/embeddings.
# LOVABLE_API_KEY=""
